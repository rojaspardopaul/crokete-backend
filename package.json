{
  "name": "crokete-backend",
  "version": "0.1.0",
  "description": "This is the server for Crokete Pet built with node, express, mongoose schema validation and mongodb as database",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon api/index.js",
    "start": "node api/index.js",
    "production": "NODE_ENV=production nodemon api/index.js",
    "data:import": "node script/seed.js",
    "product": "node script/product.js",
    "generate-password": "node script/script.js",
    "generate-reviews": "node script/reviews.js",
    "init:admin": "node scripts/init-super-admin.js",
    "update:admin-access": "node scripts/update-super-admin-access.js",
    "migrate:category-brand-separation": "node scripts/fix-category-brand-structure.js",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:gen": "tsx src/contracts/generate-openapi.ts",
    "sdk:gen": "openapi-typescript openapi.json -o src/sdk/generated/types.ts"
  },
  "author": "HtmlLover",
  "license": "Regular",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "cloudinary": "^1.26.3",
    "cors": "^2.8.5",
    "dayjs": "^1.10.7",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.1.0",
    "faker": "^5.5.3",
    "helmet": "^5.0.2",
    "js-cookie": "^3.0.1",
    "jsonwebtoken": "^9.0.0",
    "mailchecker": "^6.0.15",
    "mongoose": "^8.13.2",
    "mongoose-sequence": "^5.3.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.7.2",
    "openai": "^6.33.0",
    "pdfkit": "^0.16.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.2",
    "stripe": "^9.14.0",
    "twilio": "^5.4.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.0",
    "openapi-typescript": "^7.4.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.8"
  }
}
