{
  "name": "crokete-backend",
  "version": "0.1.0",
  "description": "Servidor de Crokete Pet: Node, Express, Prisma y PostgreSQL (Supabase)",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon api/index.js",
    "start": "node api/index.js",
    "production": "NODE_ENV=production nodemon api/index.js",
    "init:admin": "node scripts/init-super-admin.js",
    "build:ts": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:gen": "tsx src/contracts/generate-openapi.ts",
    "sdk:gen": "openapi-typescript openapi.json -o src/sdk/generated/types.ts"
  },
  "author": "HtmlLover",
  "license": "Regular",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@google/genai": "^1.46.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.10.7",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-rate-limit": "^6.1.0",
    "helmet": "^5.0.2",
    "jsonwebtoken": "^9.0.0",
    "mailchecker": "^6.0.15",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.7.2",
    "openai": "^6.33.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "prisma": "^7.9.0",
    "sharp": "^0.35.3",
    "stripe": "^9.14.0",
    "twilio": "^5.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.0",
    "openapi-typescript": "^7.4.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.8"
  }
}
