# =====================================================
# CROKETE BACKEND — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# This is the SINGLE SOURCE OF TRUTH for all secrets.
# On startup, env vars sync to the DB if the DB field is empty.
# =====================================================

PORT=5055

# ===== DATABASE (REQUERIDO) =====
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# ===== JWT (REQUERIDO) =====
# Generate with: openssl rand -hex 64
JWT_SECRET=<your-jwt-secret>
JWT_ACCESS_LIFETIME=60m
JWT_REFRESH_SECRET=<your-jwt-refresh-secret>
JWT_REFRESH_LIFETIME=7d
JWT_SECRET_FOR_VERIFY=<your-jwt-verify-secret>

# ===== ENCRYPTION (REQUERIDO — DEBE SER IGUAL en admin VITE_APP_ENCRYPT_PASSWORD) =====
# Generate with: openssl rand -hex 32
ENCRYPT_PASSWORD=<your-32-hex-key>

# ===== STRIPE (https://dashboard.stripe.com/test/apikeys) =====
# Una sola cuenta Stripe: test keys para desarrollo, live keys para produccion.
# Estos valores se sincronizan a la BD al iniciar si el campo esta vacio.
# El store frontend obtiene stripe_key desde el backend API, NO necesita su propia key.
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
MAX_AMOUNT=10000.0
MIN_AMOUNT=10.0
AMOUNT_STEP=5.0
CURRENCY=mxn
STRIPE_PAYMENT_DESCRIPTION="Pago seguro en Crokete"

# ===== EMAIL (SMTP) =====
SERVICE=zoho
EMAIL_USER=no-responder@yourdomain.com
EMAIL_PASS=<your-email-password>
HOST=smtp.zoho.com
EMAIL_PORT=465

# ===== CLOUDINARY =====
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ===== URLs =====
# Desarrollo local:
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:4100
# Produccion (descomenta):
# STORE_URL=https://tu-store.com
# ADMIN_URL=https://tu-admin.com

# ===== OAUTH (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=<openssl rand -base64 32>

# ===== SUPER ADMIN BOOTSTRAP (solo para primer setup, luego eliminar) =====
# Run: npm run init:admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=<your-password>
SUPER_ADMIN_NAME=Administrador Principal

